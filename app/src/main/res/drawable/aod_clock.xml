<?xml version="1.0" encoding="utf-8"?>
<!-- Relógio sólido (o "O" da arte "AOD": anel, ponteiros de horas e de minutos, ponto central), para o ícone do SHORT_TEXT. Tudo branco, para receber tint.
     A geometria vem de aod_text.xml (deslocada por -31,-30 para centrar o anel em 20,20); manter aod_clock e aod_clock_dim em sincronia. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <group
        android:translateX="-31"
        android:translateY="-30">
        <!-- Anel: centro 51,50, raio do traço 16,95. -->
        <path
            android:pathData="M34.05,50 A16.95,16.95 0 1 0 67.95,50 A16.95,16.95 0 1 0 34.05,50 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6" />
        <!-- Ponteiro de horas: 35 graus, comprimento 8,9. -->
        <path
            android:pathData="M51,50 L56.105,42.71"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="4.05" />
        <!-- Ponteiro de minutos: 270 graus, comprimento 13,3. -->
        <path
            android:pathData="M51,50 L37.7,50"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="3.04" />
        <!-- Ponto central, raio 2,15. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M48.85,50 A2.15,2.15 0 1 0 53.15,50 A2.15,2.15 0 1 0 48.85,50 Z" />
    </group>
</vector>
